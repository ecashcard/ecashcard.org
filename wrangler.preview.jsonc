// Preview config: the same Worker with no custom domains, so a deploy with it reaches workers.dev only.
// npx wrangler deploy --config wrangler.preview.jsonc
{
  "name": "ecashcard-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  // Workers Caching: Cloudflare keeps each full video and serves byte-range slices of it from cache
  "cache": { "enabled": true },
  "observability": { "enabled": true }
}
